# Copy to .env beside compose.yaml. Keep the resulting file private.
HERALD_HTTP_PORT=3000
BETTER_AUTH_URL=http://127.0.0.1:3000
HERALD_WEB_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
HERALD_MEDIA_PUBLIC_URL_SECRET=
HERALD_PUBLISHER_ENCRYPTION_KEY=
HERALD_PUBLISHER_ENCRYPTION_KEY_ID=v1
HERALD_MEDIA_STORE=local
HERALD_MEDIA_STORE_ID=local-default
LOG_LEVEL=error

# Optional SMTP. Leave the entire group unset when not used.
# HERALD_EMAIL_SMTP_HOST=smtp.example.com
# HERALD_EMAIL_SMTP_PORT=587
# HERALD_EMAIL_SMTP_SECURE=false
# HERALD_EMAIL_SMTP_USERNAME=
# HERALD_EMAIL_SMTP_PASSWORD=
# HERALD_EMAIL_FROM=Herald <no-reply@example.com>
