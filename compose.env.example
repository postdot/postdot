# Copy to .env beside compose.yaml. Keep the resulting file private.
# Optional published image; unset keeps the local source build.
# POSTBOT_IMAGE=ghcr.io/postdot/postdot:0.1.0-alpha.1
POSTBOT_HTTP_PORT=3000
BETTER_AUTH_URL=http://127.0.0.1:3000
POSTBOT_WEB_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
POSTBOT_MEDIA_PUBLIC_URL_SECRET=
POSTBOT_PUBLISHER_ENCRYPTION_KEY=
POSTBOT_PUBLISHER_ENCRYPTION_KEY_ID=v1
POSTBOT_MEDIA_STORE=local
POSTBOT_MEDIA_STORE_ID=local-default
LOG_LEVEL=error

# Optional SMTP. Leave the entire group unset when not used.
# POSTBOT_EMAIL_SMTP_HOST=smtp.example.com
# POSTBOT_EMAIL_SMTP_PORT=587
# POSTBOT_EMAIL_SMTP_SECURE=false
# POSTBOT_EMAIL_SMTP_USERNAME=
# POSTBOT_EMAIL_SMTP_PASSWORD=
# POSTBOT_EMAIL_FROM=Postbot <no-reply@example.com>
