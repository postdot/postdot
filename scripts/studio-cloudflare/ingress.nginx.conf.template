# Include inside a dedicated HTTPS server block, with no access to the raw API port.
# Render only the three POSTDOT_* placeholders; keep Nginx variables intact.
if ($http_x_postdot_ingress != "${POSTDOT_INGRESS_SECRET}") { return 403; }

location ~ ^/(api|oauth)(/|$) {
    proxy_pass http://${POSTDOT_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host ${POSTDOT_PUBLIC_HOST};
    proxy_set_header X-Forwarded-For $http_x_postdot_client_address;
    proxy_set_header X-Forwarded-Host ${POSTDOT_PUBLIC_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Postdot-Ingress "";
    proxy_set_header X-Postdot-Client-Address "";
    proxy_set_header X-Postdot-Client-IP "";
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_intercept_errors off;
    proxy_read_timeout 300s;
    client_max_body_size 100m;
    add_header Cache-Control "no-store" always;
}

location / { return 404; }
