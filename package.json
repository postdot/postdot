{
    "name": "herald",
    "private": true,
    "description": "Lightweight, self-hosted multichannel publication orchestrator",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint && oxlint --deny-warnings scripts",
        "lint:fix": "turbo lint:fix && oxlint --fix scripts",
        "format": "turbo format && oxfmt --check scripts package.json turbo.json tsconfig.json bunfig.toml *.config.*",
        "format:fix": "turbo format:fix && oxfmt --write scripts package.json turbo.json tsconfig.json bunfig.toml *.config.*",
        "typecheck": "tsc --noEmit && turbo typecheck",
        "test": "turbo test",
        "test:coverage": "bun test --coverage",
        "measure:footprint": "bun run build && bun run scripts/measure-footprint.ts",
        "clean": "turbo clean && rimraf node_modules",
        "check": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build",
        "prepare": "husky",
        "autonomos": "autonomos",
        "herald": "bun run scripts/herald.ts"
    },
    "dependencies": {
        "@herald/client": "workspace:*"
    },
    "devDependencies": {
        "@autonomos/cli": "^0.5.0",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@tala-tools/oxfmt": "0.0.1",
        "@tala-tools/oxlint": "0.0.1",
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.0",
        "husky": "9.1.7",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "rimraf": "^6.1.3",
        "turbo": "^2.10.11",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4"
    },
    "packageManager": "bun@1.4.0"
}
