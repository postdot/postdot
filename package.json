{
    "name": "postdot",
    "private": true,
    "description": "Lightweight, self-hosted multichannel publication orchestrator",
    "license": "AGPL-3.0-only",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "turbo build",
        "build-storybook": "bun run --cwd packages/ui build-storybook",
        "dev": "turbo dev",
        "lint": "turbo lint && oxlint --deny-warnings scripts e2e *.config.* && bun run lint:spelling",
        "lint:spelling": "cspell lint --dot --gitignore --no-progress --no-summary --show-context --cache",
        "lint:fix": "turbo lint:fix && oxlint --fix scripts e2e *.config.*",
        "format": "turbo format && oxfmt --check scripts e2e package.json cspell.json turbo.json tsconfig.json bunfig.toml *.config.*",
        "format:fix": "turbo format:fix && oxfmt --write scripts e2e package.json cspell.json turbo.json tsconfig.json bunfig.toml *.config.*",
        "typecheck": "tsc --noEmit && turbo typecheck",
        "test": "bun run test:unit && bun run test:e2e",
        "test:unit": "turbo test && bun run test:scripts",
        "test:scripts": "bun test scripts",
        "test:e2e": "playwright test && bun run test:e2e:password-reset",
        "test:e2e:password-reset": "bun run scripts/e2e-password-reset.ts",
        "test:e2e:affected": "bun run scripts/e2e-affected.ts",
        "test:container:recovery": "bun run scripts/production-container-recovery.ts",
        "test:coverage": "bun test --coverage --path-ignore-patterns='e2e/**'",
        "measure:footprint": "bun run build && bun run scripts/measure-footprint.ts",
        "benchmark:analytics": "bun run scripts/benchmark-analytics.ts",
        "i18n:coverage": "bun run --cwd apps/web i18n:coverage",
        "clean": "turbo clean && rimraf node_modules",
        "check:quick": "bun run format && bun run lint && bun run typecheck",
        "check": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build",
        "prepare": "husky",
        "storybook": "bun run --cwd packages/ui storybook",
        "autonomos": "autonomos",
        "postdot": "bun run scripts/postbot.ts",
        "postbot": "bun run scripts/postbot.ts"
    },
    "dependencies": {
        "@postdot/client": "workspace:*"
    },
    "devDependencies": {
        "@autonomos/cli": "^0.6.0",
        "@axe-core/playwright": "^4.13.0",
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.3",
        "@playwright/test": "1.63.0",
        "@tala-tools/oxfmt": "0.0.1",
        "@tala-tools/oxlint": "0.0.1",
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.2",
        "@types/node": "26.6.3",
        "cspell": "^10.3.6",
        "husky": "9.1.7",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "rimraf": "^6.1.3",
        "turbo": "^2.11.6",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4.2"
    },
    "packageManager": "bun@1.4.2"
}
