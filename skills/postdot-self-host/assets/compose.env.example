# Copy to .env beside compose.yaml. Keep the resulting file private.
# Optional published image; unset keeps the local source build.
# POSTDOT_IMAGE=ghcr.io/postdot/postdot:0.1.0-alpha.3
POSTDOT_HTTP_PORT=3000
BETTER_AUTH_URL=http://127.0.0.1:3000
POSTDOT_WEB_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
POSTDOT_MEDIA_PUBLIC_URL_SECRET=
POSTDOT_PUBLISHER_ENCRYPTION_KEY=
POSTDOT_PUBLISHER_ENCRYPTION_KEY_ID=v1
POSTDOT_MEDIA_STORE=local
POSTDOT_MEDIA_STORE_ID=local-default
LOG_LEVEL=error

# Optional SMTP. Leave the entire group unset when not used.
# POSTDOT_EMAIL_SMTP_HOST=smtp.example.com
# POSTDOT_EMAIL_SMTP_PORT=587
# POSTDOT_EMAIL_SMTP_SECURE=false
# POSTDOT_EMAIL_SMTP_USERNAME=
# POSTDOT_EMAIL_SMTP_PASSWORD=
# POSTDOT_EMAIL_FROM=Postdot <no-reply@example.com>
