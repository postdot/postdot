{
    "name": "@postdot/integrations",
    "private": true,
    "workspaces": [
        "n8n",
        "cli"
    ],
    "scripts": {
        "changeset": "changeset",
        "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
        "release": "node scripts/publish.mjs",
        "build": "npm run build --workspace @postdot/n8n-nodes-postdot",
        "typecheck": "npm run typecheck --workspace @postdot/n8n-nodes-postdot",
        "lint": "npm run lint --workspace @postdot/n8n-nodes-postdot",
        "prepare:cli": "node scripts/prepare-cli.mjs",
        "pack:release": "node scripts/pack-release.mjs",
        "bootstrap:cli": "node scripts/bootstrap-cli.mjs"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3"
    },
    "overrides": {
        "@oclif/core": {
            "minimatch": "^11.0.1"
        },
        "@ts-morph/common": {
            "minimatch": "^11.0.1"
        },
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.1"
        },
        "eslint-plugin-import-x": {
            "minimatch": "^11.0.1"
        },
        "glob": {
            "minimatch": "^11.0.1"
        },
        "qs": "^6.16.1",
        "stream-json": "^3.6.0",
        "uuid@^10.0.0": "11.1.1"
    },
    "engines": {
        "node": "24.x"
    }
}
