{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", "build/**", ".vite/**", "!.vite/deps/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "lint:fix": {
            "dependsOn": ["^lint:fix"]
        },
        "format": {
            "dependsOn": ["^format"]
        },
        "format:fix": {
            "dependsOn": ["^format:fix"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "test": {
            "outputs": []
        },
        "clean": {
            "outputs": [],
            "cache": false
        }
    }
}
