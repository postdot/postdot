{
    "name": "@herald/web",
    "private": true,
    "type": "module",
    "scripts": {
        "prebuild": "bun run i18n:compile && bun run i18n:coverage",
        "pretest": "bun run i18n:compile && bun run i18n:coverage",
        "pretypecheck": "bun run i18n:compile && bun run i18n:coverage",
        "build": "vite build",
        "dev": "vite --host 0.0.0.0",
        "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations",
        "i18n:coverage": "bun ../../scripts/i18n-coverage.ts",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@herald/client": "workspace:*",
        "@herald/ui": "workspace:*",
        "@solar-icons/react": "2.1.0",
        "@tanstack/query-db-collection": "^1.2.12",
        "@tanstack/react-db": "^0.3.7",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-router": "1.170.32",
        "@wrksz/themes": "^2.0.0-beta.2",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "2.25.0",
        "@tailwindcss/vite": "4.3.3",
        "@tala-tools/tsconfig": "0.1.0",
        "@tanstack/router-plugin": "1.168.35",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitejs/plugin-react": "6.1.1",
        "shadcn": "4.19.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.2.2"
    },
    "engines": {
        "bun": ">=1.4"
    }
}
