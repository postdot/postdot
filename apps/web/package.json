{
    "name": "@herald/web",
    "private": true,
    "type": "module",
    "scripts": {
        "prebuild": "bun run i18n:compile && bun run i18n:coverage",
        "pretest": "bun run i18n:compile && bun run i18n:coverage",
        "pretypecheck": "bun run i18n:compile && bun run i18n:coverage",
        "build": "vite build",
        "dev": "vite --host 0.0.0.0",
        "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations",
        "i18n:coverage": "bun ../../scripts/i18n-coverage.ts",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@date-fns/tz": "1.5.0",
        "@dicebear/core": "10.7.0",
        "@dicebear/styles": "10.6.0",
        "@herald/client": "workspace:*",
        "@herald/core": "workspace:*",
        "@herald/ui": "workspace:*",
        "@herald/x": "workspace:*",
        "@iconify-icons/flag": "2.0.0",
        "@iconify-icons/logos": "2.0.2",
        "@iconify/react": "6.0.2",
        "@solar-icons/react": "2.3.2",
        "@tanstack/hotkeys": "0.10.1",
        "@tanstack/query-db-collection": "^1.3.1",
        "@tanstack/react-db": "^0.5.0",
        "@tanstack/react-hotkeys": "^0.12.1",
        "@tanstack/react-query": "^5.104.0",
        "@tanstack/react-router": "1.170.41",
        "@uppy/core": "6.2.0",
        "@uppy/golden-retriever": "6.0.0",
        "@uppy/react": "6.0.0",
        "@wrksz/themes": "^2.0.2",
        "date-fns": "4.4.0",
        "frimousse": "0.4.0",
        "mdast-util-gfm-strikethrough": "2.0.1",
        "micromark-extension-gfm-strikethrough": "2.1.0",
        "motion": "13.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-easy-crop": "6.2.3",
        "react-full-screen": "1.1.1",
        "react-markdown": "10.1.0",
        "react-zoom-pan-pinch": "4.2.0",
        "remark-inline-spoiler": "2.1.0"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "2.25.4",
        "@storybook/react-vite": "10.6.1",
        "@tailwindcss/vite": "4.3.3",
        "@tala-tools/tsconfig": "0.1.0",
        "@tanstack/router-plugin": "1.168.42",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "emojibase-data": "17.0.0",
        "shadcn": "4.21.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.1"
    },
    "engines": {
        "bun": ">=1.4.2"
    }
}
