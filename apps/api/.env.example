NODE_ENV=development
PORT=3000
DB_FILE_NAME=./herald.sqlite
HERALD_MIGRATIONS_DIR=../../packages/db/drizzle
HERALD_WEB_ASSETS_DIR=../../apps/web/dist
HERALD_MEDIA_STORE=local
HERALD_MEDIA_DIRECTORY=../../data/media
HERALD_MEDIA_STORE_ID=local-default
HERALD_MEDIA_MAX_OBJECT_BYTES=100000000
HERALD_MEDIA_UPLOAD_TTL_MS=900000
HERALD_MEDIA_DELETION_GRACE_MS=86400000
HERALD_MEDIA_PUBLIC_URL_TTL_MS=900000
# Optional S3-compatible media storage. Set HERALD_MEDIA_STORE=s3 and all required values.
# HERALD_MEDIA_S3_BUCKET=
# HERALD_MEDIA_S3_REGION=
# HERALD_MEDIA_S3_ENDPOINT=
# HERALD_MEDIA_S3_ACCESS_KEY_ID=
# HERALD_MEDIA_S3_SECRET_ACCESS_KEY=
# HERALD_MEDIA_S3_SESSION_TOKEN=
# HERALD_MEDIA_S3_PREFIX=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Used only to sign short-lived public media delivery URLs; this is not a channel credential.
HERALD_MEDIA_PUBLIC_URL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
HERALD_PUBLISHER_ENCRYPTION_KEY=replace-with-64-hex-characters
HERALD_PUBLISHER_ENCRYPTION_KEY_ID=v1
# Optional: enable the LinkedIn publisher connection flow.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Optional: enable Bluesky OAuth with a public HTTPS client metadata URL.
# For local HTTP development, use 127.0.0.1 consistently in BETTER_AUTH_URL and HERALD_WEB_ORIGIN.
# BLUESKY_CLIENT_METADATA_URL=
BLUESKY_HANDLE_RESOLVER=https://bsky.social
HERALD_WEB_ORIGIN=http://localhost:5173
# Optional operator-owned private custom HTTP destinations as a JSON array.
# Example: [{"kind":"cidr","cidr":"127.0.0.0/8","port":8080,"schemes":["http"]}]
# HERALD_CUSTOM_HTTP_PRIVATE_DESTINATIONS=
LOG_LEVEL=info
LOG_PRETTY=true
