NODE_ENV=development
PORT=3000
DB_FILE_NAME=./postdot.sqlite
POSTDOT_MIGRATIONS_DIR=../../packages/db/drizzle
POSTDOT_WEB_ASSETS_DIR=../../apps/web/dist
POSTDOT_MEDIA_STORE=local
POSTDOT_MEDIA_DIRECTORY=../../data/media
POSTDOT_MEDIA_STORE_ID=local-default
POSTDOT_MEDIA_MAX_OBJECT_BYTES=100000000
POSTDOT_MEDIA_UPLOAD_TTL_MS=900000
POSTDOT_MEDIA_DELETION_GRACE_MS=86400000
POSTDOT_MEDIA_PUBLIC_URL_TTL_MS=900000
# Optional S3-compatible media storage. Set POSTDOT_MEDIA_STORE=s3 and all required values.
# POSTDOT_MEDIA_S3_BUCKET=
# POSTDOT_MEDIA_S3_REGION=
# POSTDOT_MEDIA_S3_ENDPOINT=
# POSTDOT_MEDIA_S3_ACCESS_KEY_ID=
# POSTDOT_MEDIA_S3_SECRET_ACCESS_KEY=
# POSTDOT_MEDIA_S3_SESSION_TOKEN=
# POSTDOT_MEDIA_S3_PREFIX=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional SMTP delivery for invitations, account verification, and password reset.
# Leave these unset for local/manual-link operation. A relay may be unauthenticated.
# For the repository's local Mailpit relay, use 127.0.0.1:1025 and open
# http://127.0.0.1:8025 to inspect messages.
# POSTDOT_EMAIL_SMTP_HOST=
# POSTDOT_EMAIL_SMTP_PORT=587
# POSTDOT_EMAIL_SMTP_SECURE=false
# POSTDOT_EMAIL_SMTP_USERNAME=
# POSTDOT_EMAIL_SMTP_PASSWORD=
# POSTDOT_EMAIL_FROM=Postdot <no-reply@example.com>
# Enable only when the deployment also configures verified-account email delivery.
POSTDOT_REQUIRE_EMAIL_VERIFICATION_ON_INVITATION=false
# Used only to sign short-lived public media delivery URLs; this is not a channel credential.
POSTDOT_MEDIA_PUBLIC_URL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTDOT_PUBLISHER_ENCRYPTION_KEY=replace-with-64-hex-characters
POSTDOT_PUBLISHER_ENCRYPTION_KEY_ID=v1
# Optional: enable the LinkedIn publisher connection flow.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Optional compatibility path: enable Bluesky public-web OAuth with a stable
# HTTPS client metadata URL. For local loopback OAuth, leave this unset and
# create a Bluesky provider application from the Postdot settings page instead.
# Local loopback requires 127.0.0.1 consistently in BETTER_AUTH_URL,
# POSTDOT_WEB_ORIGIN, POSTDOT_API_ORIGIN, and the browser address.
# BLUESKY_CLIENT_METADATA_URL=
BLUESKY_HANDLE_RESOLVER=https://bsky.social
# Optional: enable the X (Twitter) publisher connection flow.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
POSTDOT_WEB_ORIGIN=http://localhost:5173
# Optional operator-owned private outbound destinations as a JSON array. This
# applies to custom HTTP and per-instance built-in providers such as Mastodon.
# Example: [{"kind":"cidr","cidr":"127.0.0.0/8","port":8080,"schemes":["http"]}]
# POSTDOT_OUTBOUND_PRIVATE_DESTINATIONS=
# Optional Prometheus scrape endpoint. Disabled unless explicitly enabled.
# When enabled, provide a dedicated random token of at least 32 characters.
# POSTDOT_METRICS_ENABLED=false
# POSTDOT_METRICS_TOKEN=
# Development default. Production defaults to error; set silent to disable all logs.
LOG_LEVEL=info
LOG_PRETTY=true
