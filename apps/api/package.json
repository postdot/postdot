{
    "name": "@postdot/api",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify",
        "dev": "bun ../../scripts/dev-api.ts",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo",
        "test": "bun test"
    },
    "dependencies": {
        "@atproto/api": "0.22.0",
        "@elysia/static": "2.0.0-beta.2",
        "@elysiajs/openapi": "2.0.0-exp.0",
        "@postdot/auth": "workspace:*",
        "@postdot/bluesky": "workspace:*",
        "@postdot/core": "workspace:*",
        "@postdot/custom-http": "workspace:*",
        "@postdot/db": "workspace:*",
        "@postdot/devto": "workspace:*",
        "@postdot/discord": "workspace:*",
        "@postdot/email": "workspace:*",
        "@postdot/facebook": "workspace:*",
        "@postdot/instagram": "workspace:*",
        "@postdot/linkedin": "workspace:*",
        "@postdot/mastodon": "workspace:*",
        "@postdot/media": "workspace:*",
        "@postdot/oauth": "workspace:*",
        "@postdot/telegram": "workspace:*",
        "@postdot/x": "workspace:*",
        "@prometheus-io/client": "0.16.1",
        "@sinclair/typebox": "^0.34.52",
        "drizzle-orm": "0.45.3",
        "drizzle-typebox": "^0.3.3",
        "elysia": "^2.0.0-exp.64",
        "exact-mirror": "1.2.6",
        "nodemailer": "^10.0.13",
        "openapi-types": "12.1.3",
        "pino": "10.3.1",
        "typebox": "1.3.34"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.4",
        "@types/nodemailer": "^8.0.2",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4.4"
    }
}
