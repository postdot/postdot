{
    "name": "@herald/api",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify",
        "dev": "bun --env-file=.env --watch ./src/index.ts",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo",
        "test": "bun test"
    },
    "dependencies": {
        "@atproto/api": "0.20.42",
        "@elysia/static": "2.0.0-beta.2",
        "@elysiajs/openapi": "2.0.0-exp.0",
        "@herald/auth": "workspace:*",
        "@herald/bluesky": "workspace:*",
        "@herald/core": "workspace:*",
        "@herald/custom-http": "workspace:*",
        "@herald/db": "workspace:*",
        "@herald/devto": "workspace:*",
        "@herald/discord": "workspace:*",
        "@herald/linkedin": "workspace:*",
        "@herald/mastodon": "workspace:*",
        "@herald/media": "workspace:*",
        "@herald/oauth": "workspace:*",
        "@herald/x": "workspace:*",
        "@sinclair/typebox": "^0.34.52",
        "drizzle-orm": "0.45.2",
        "drizzle-typebox": "^0.3.3",
        "elysia": "^2.0.0-beta.10",
        "exact-mirror": "1.2.4",
        "nodemailer": "^10.0.6",
        "openapi-types": "12.1.3",
        "pino": "10.3.1",
        "typebox": "1.3.20"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.0",
        "@types/nodemailer": "^8.0.1",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4"
    }
}
