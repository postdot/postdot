{
    "name": "@postdot/docs",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "bun run sync:content && vite dev --port 5174",
        "build": "bun scripts/build.ts",
        "sync:content": "bun run sync:openapi && bun scripts/generate-og-material.ts",
        "lint": "oxlint --deny-warnings .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "bun run sync:content && tsc --noEmit",
        "clean": "rimraf dist .source .tanstack .wrangler public/og public/_headers public/_redirects public/robots.txt .turbo",
        "preview": "wrangler dev --ip 127.0.0.1 --port 5174",
        "deploy": "bun run build && wrangler deploy",
        "deploy:dry": "bun run build && wrangler deploy --dry-run",
        "sync:openapi": "bun ../api/src/openapi-export.ts .openapi/postbot.json && bun scripts/sync-openapi.ts",
        "sync:umami": "bun scripts/sync-umami.ts",
        "generate:og": "bun scripts/generate-og-images.tsx",
        "check:links": "bun scripts/check-links.ts",
        "check:llms": "bun scripts/check-llms.ts",
        "check:og": "bun scripts/check-og.ts"
    },
    "dependencies": {
        "@postdot/ui": "workspace:*",
        "@solar-icons/react": "2.3.2",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-start": "1.169.4",
        "@tanstack/start-static-server-functions": "1.167.44",
        "@wrksz/themes": "1.1.0",
        "fumadocs-core": "16.17.8",
        "fumadocs-mdx": "15.4.10",
        "fumadocs-openapi": "12.5.5",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
        "json-schema-typed": "8.0.2",
        "lenis": "1.3.26",
        "motion": "13.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "shiki": "4.5.0"
    },
    "devDependencies": {
        "@fontsource/host-grotesk": "5.3.0",
        "@iconify-json/logos": "1.2.17",
        "@iconify-json/ph": "1.2.2",
        "@iconify/utils": "3.1.7",
        "@resvg/resvg-js": "2.6.2",
        "@svgr/core": "8.1.0",
        "@svgr/plugin-jsx": "8.1.0",
        "@tailwindcss/vite": "4.3.3",
        "@tala-tools/tsconfig": "0.1.0",
        "@tanstack/intent": "0.5.6",
        "@types/mdx": "2.0.14",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "satori": "0.63.2",
        "tailwindcss": "4.3.3",
        "unplugin-icons": "24.0.0",
        "vite": "8.3.1",
        "wrangler": "4.152.0"
    }
}
