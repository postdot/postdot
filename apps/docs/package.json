{
    "name": "@herald/docs",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "bun run sync:content && bun run --bun next dev --port 5174",
        "build": "bun run sync:content && bun run --bun next build",
        "sync:content": "bun scripts/sync-content.ts && fumadocs-mdx",
        "lint": "oxlint --deny-warnings .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "bun run sync:content && tsc --noEmit",
        "clean": "rimraf .next out .source .turbo"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@fontsource-variable/recursive": "5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "fumadocs-core": "16.17.1",
        "fumadocs-mdx": "15.4.7",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
        "motion": "13.4.6",
        "next": "16.3.6",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.3",
        "@tala-tools/tsconfig": "0.1.0",
        "@types/mdx": "2.0.14",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "tailwindcss": "4.3.3"
    }
}
