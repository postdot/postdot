{
    "extends": "@tala-tools/tsconfig/base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["DOM", "DOM.Iterable", "ES2023"],
        "types": ["vite/client", "node", "unplugin-icons/types/react"],
        "paths": {
            "fumadocs-mdx:collections/*": ["./.source/*"],
            "@/*": ["./src/*"],
            "fumadocs-core/*": ["./node_modules/fumadocs-core/dist/*"]
        },
        "allowJs": true,
        "declaration": false,
        "declarationMap": false,
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.tsx", ".source/**/*.ts"],
    "exclude": ["node_modules", "dist", ".tanstack", ".wrangler"]
}
