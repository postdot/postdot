{
    "name": "@postdot/bluesky",
    "version": "0.0.0",
    "private": true,
    "description": "Bluesky and AT Protocol publishing adapter for Postdot",
    "license": "AGPL-3.0-only",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@atproto/api": "0.22.0",
        "@atproto/common-web": "0.5.13",
        "@atproto/jwk-jose": "0.2.4",
        "@atproto/jwk-webcrypto": "0.3.4",
        "@atproto/oauth-client": "0.8.8",
        "@atproto/oauth-types": "0.7.7",
        "@postdot/core": "workspace:*"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.4",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4.4"
    }
}
