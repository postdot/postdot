{
    "extends": "@tala-tools/tsconfig/bun-react-library.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["bun"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        ".storybook/**/*.ts",
        ".storybook/**/*.tsx",
        "vite.config.ts"
    ],
    "exclude": ["dist", "node_modules", ".turbo"]
}
