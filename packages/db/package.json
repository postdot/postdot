{
    "name": "@herald/db",
    "version": "0.0.0",
    "private": true,
    "description": "Drizzle ORM database access for Herald",
    "license": "AGPL-3.0-only",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./schema": "./src/schema.ts"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:migrate": "bun run src/migrate.ts",
        "test": "bun test"
    },
    "dependencies": {
        "@herald/core": "workspace:*",
        "@herald/media": "workspace:*",
        "drizzle-orm": "0.45.3",
        "mp4box": "2.4.1"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.2",
        "@types/node": "26.6.3",
        "drizzle-kit": "0.31.11",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4.2"
    }
}
