{
    "name": "@postdot/db",
    "version": "0.0.0",
    "private": true,
    "description": "Drizzle ORM database access for Postdot",
    "license": "AGPL-3.0-only",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./testing": "./src/testing.ts"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun",
        "lint": "oxlint --type-aware --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo",
        "db:migrate": "bun run src/migrate.ts",
        "test": "bun test"
    },
    "dependencies": {
        "@postdot/core": "workspace:*",
        "@postdot/media": "workspace:*",
        "mp4box": "2.4.1"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.4",
        "@types/node": "26.6.3",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4.4"
    }
}
