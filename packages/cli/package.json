{
    "name": "@postdot/cli",
    "version": "0.1.0-alpha.0",
    "description": "Operate a remote Postdot instance from your terminal",
    "homepage": "https://postdot.app/docs/cli-reference/",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postdot/postdot.git",
        "directory": "packages/cli"
    },
    "bin": {
        "postdot": "dist/cli.js"
    },
    "files": [
        "dist/cli.js",
        "LICENSE",
        "README.md",
        "THIRD-PARTY-NOTICES"
    ],
    "type": "module",
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    },
    "scripts": {
        "build": "bun run build.ts",
        "build:executable": "bun run build.ts --compile",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "clean": "rimraf dist .turbo"
    },
    "devDependencies": {
        "@postdot/client": "workspace:*",
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.4",
        "commander": "15.0.0",
        "typescript": "7.0.2"
    }
}
