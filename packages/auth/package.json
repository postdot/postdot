{
    "name": "@herald/auth",
    "version": "0.0.0",
    "private": true,
    "description": "Better Auth configuration for Herald",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo",
        "test": "bun test"
    },
    "dependencies": {
        "@better-auth/api-key": "1.7.2",
        "@herald/db": "workspace:*",
        "better-auth": "1.7.2"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.1.0",
        "@types/bun": "1.4.0",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4"
    }
}
